<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">OfflineU</string>

    <!-- Login -->
    <string name="login_tagline">Your courses, on every screen.</string>
    <string name="login_heading">Connect to your server</string>
    <string name="login_description">Enter the address of the OfflineU server. The phone must be able to reach it over Wi-Fi or the internet.</string>
    <string name="login_server_label">Server address</string>
    <string name="login_server_hint">http://192.168.1.10:5000</string>
    <string name="login_server_help">Use the LAN address of the computer, NAS or Docker host that runs OfflineU. On a phone, 127.0.0.1 points at the phone itself.</string>
    <string name="login_connect">Connect</string>
    <string name="login_checking">Checking the server…</string>
    <string name="login_invalid_url">Enter a valid http:// or https:// address, for example http://192.168.1.10:5000.</string>
    <string name="login_http_error">The server answered with HTTP %1$d.</string>
    <string name="login_not_offlineu">That address answered, but it does not look like an OfflineU server.</string>
    <string name="login_save_anyway_title">Cannot verify the server</string>
    <string name="login_save_anyway_message">OfflineU could not verify %1$s:\n\n%2$s\n\nYou can open it anyway if the server is still starting or its health check is blocked.</string>
    <string name="login_open_anyway">Open anyway</string>

    <!-- Course source entered at login -->
    <string name="login_source_label">Course source (optional)</string>
    <string name="login_source_help">Connect a WebDAV server, an SMB share or a folder on the server. Credentials are saved on the server, never on this phone.</string>
    <string name="login_source_none">Use sources already on the server</string>
    <string name="login_source_webdav">WebDAV</string>
    <string name="login_source_smb">SMB / Windows share</string>
    <string name="login_source_local">Folder on the server</string>
    <string name="login_source_url_hint">https://nas.local:5006/dav/courses</string>
    <string name="login_source_user_hint">Username</string>
    <string name="login_source_password_hint">Password</string>
    <string name="login_source_host_hint">Server (IP or name)</string>
    <string name="login_source_share_hint">Share name</string>
    <string name="login_source_base_hint">Folder inside the share (optional)</string>
    <string name="login_source_path_hint">/mnt/courses</string>
    <string name="login_source_incomplete">Fill in the source address, host/share or folder first, or choose “Use sources already on the server”.</string>
    <string name="login_source_connecting">Connecting the course source…</string>
    <string name="login_source_failed_title">Course source not added</string>
    <string name="login_source_failed_message">%1$s\n\nYou can still open the server and add the source on the web page.</string>
    <string name="login_open_without_source">Open without source</string>

    <!-- Toolbar menu -->
    <string name="menu_reload">Reload</string>
    <string name="menu_open_browser">Open in browser</string>
    <string name="menu_change_server">Change server</string>
    <string name="menu_clear_data">Clear site data</string>

    <!-- Main screen -->
    <string name="main_error_title">Cannot reach the server</string>
    <string name="main_error_message">OfflineU could not load %1$s.\n\nCheck that the server is running and that this phone is on the same network.</string>
    <string name="main_error_retry">Retry</string>
    <string name="main_error_change_server">Change server</string>
    <string name="external_opened">Opened in your browser</string>
    <string name="no_app_for_link">No installed app can open this link.</string>
    <string name="back_again_to_exit">Press back again to exit</string>
    <string name="ssl_title">Untrusted certificate</string>
    <string name="ssl_message">The certificate presented by %1$s is not trusted by this phone.\n\nContinue only if you trust this server, for example a NAS with a self-signed certificate.</string>
    <string name="ssl_continue">Continue</string>
    <string name="file_chooser_title">Choose a file</string>

    <!-- Clear site data -->
    <string name="clear_data_title">Clear site data?</string>
    <string name="clear_data_message">This clears the WebView cache, cookies and navigation history for OfflineU. Your learning progress on the server is not affected.</string>
    <string name="clear_data_confirm">Clear</string>
    <string name="clear_data_done">Site data cleared</string>

    <string name="cancel">Cancel</string>
</resources>
