#!/bin/bash
# fnOS 应用生命周期入口。Docker 类应用的启停由应用中心直接执行 compose，
# 这里 start/stop 只需返回成功；status 用 offlineu 容器的运行状态代表应用状态。
set -u
CONTAINER="offlineu"
is_running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = "true" ]
}
case "${1:-}" in
  start) exit 0 ;;
  stop) exit 0 ;;
  status) if is_running; then exit 0; else exit 3; fi ;;
  *) exit 0 ;;
esac
