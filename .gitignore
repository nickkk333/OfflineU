# ---- Go ----
/offlineu
/offlineu.exe
*.test

# ---- Node / Vue frontend ----
node_modules/
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# ---- OfflineU runtime data ----
.offlineu_progress.json
*_progress.json
*.json.tmp
courses/
data/

# ---- Windows exe produced by build-windows.ps1 ----
/dist/
/offlineu-*.exe
# static ffmpeg downloaded for the bundled build (build tag bundleffmpeg)
/internal/offlineu/ffmpegwin/

# ---- Exported docker images (docker save) ----
/image-dist/
*.tar

# ---- fnOS package artifacts & local build tool (rebuilt via fnos/build.ps1) ----
*.fpk
/fnos/fnpack.exe
/fnos/fnpack
# bundled offline image tar (built + saved by fnos/build.ps1; *.tar above covers it)
/fnos/offlineu/app/images/

# ---- Media files dropped in the repo root for manual testing ----
# Handy to have a sample lesson around, far too big to end up in git: the test
# suites build their own fixtures in temporary folders.
/*.mkv
/*.mp4
/*.ts
/*.mov

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---- E2E harness (e2e/) ----
# The suites, lib.mjs, package.json and fakerenderer/ are source; everything the
# runs produce (binaries, downloaded browsers, progress files, *.log above) is not.
/e2e/fakerenderer.exe
/e2e/offlineu-*-amd64
/e2e/node_modules/
/e2e/exe-data/
