# Keep fnOS shell/scripts with LF endings so they run under fnOS (Linux).
# Without this, git's autocrlf on Windows would store/checkout CRLF and break
# the `#!/bin/bash` shebang once the package is installed on the NAS.
fnos/offlineu/cmd/*         text eol=lf
fnos/offlineu/wizard/*      text eol=lf
fnos/offlineu/config/*      text eol=lf
fnos/offlineu/manifest      text eol=lf
fnos/offlineu/app/docker/docker-compose.yaml  text eol=lf
fnos/build.ps1              text eol=lf
