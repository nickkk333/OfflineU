#!/bin/bash
# Docker 模式：容器由 fnOS 的 docker-project 机制托管，挂载路径由 compose 里的
# ${wizard_*} / ${TRIM_*} 在创建容器时替换，start/stop 对系统来说是空操作，
# status 直接查容器状态。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

is_docker_running() {
    local name=""
    if [ -f "${FILE_PATH}" ]; then
        name=$(grep "container_name" "${FILE_PATH}" | awk -F ':' '{print $2}' | xargs)
    fi
    [ -n "${name}" ] || return 1
    docker inspect "${name}" >/dev/null 2>&1 || return 1
    docker inspect "${name}" | grep -q "\"Status\": \"running\","
}

case $1 in
start)
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
